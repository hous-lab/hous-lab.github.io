---
/**
 * Footer 覆盖：在原内容（EditLink / LastUpdated / Pagination / credits）
 * 之前挂载互动条（Engagement）与评论区（Comments）。
 *
 * 注意：保持 virtual:starlight/components/* 的导入方式，
 * 这样兄弟组件的覆盖级联仍然生效。
 */
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
import Engagement from '../engagement/Engagement.astro';
import Comments from '../engagement/Comments.astro';

const route = Astro.locals.starlightRoute;
const isDoc = route.entry.data.template !== 'splash';
const showComments = isDoc && route.entry.data.comments !== false;
---

{
  isDoc && (
    <>
      <Engagement />
      {showComments && <Comments />}
    </>
  )
}

<footer class="sl-flex">
  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />

  {
    config.credits && (
      <a class="kudos sl-flex" href="https://starlight.astro.build">
        <Icon name={'starlight'} /> {Astro.locals.t('builtWithStarlight.label')}
      </a>
    )
  }
</footer>

<style>
  @layer starlight.core {
    footer {
      flex-direction: column;
      gap: 1.5rem;
    }
    .meta {
      gap: 0.75rem 3rem;
      justify-content: space-between;
      flex-wrap: wrap;
      margin-top: 3rem;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
    }
    .meta > :global(p:only-child) {
      margin-inline-start: auto;
    }

    .kudos {
      align-items: center;
      gap: 0.5em;
      margin: 1.5rem auto;
      font-size: var(--sl-text-xs);
      text-decoration: none;
      color: var(--sl-color-gray-3);
    }
    .kudos:hover {
      color: var(--sl-color-white);
    }
  }

  @layer starlight.components {
    .kudos :global(svg) {
      color: var(--sl-color-orange);
    }
  }
</style>
